# Local development config. Copy to .env and fill in.
#
# Production values live in `fly secrets` and never in this file or the repo.
# Everything here is read by app/config.py; a setting missing from this file is
# one someone will discover as a runtime failure with no obvious cause.

# ---------------------------------------------------------------- essentials
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/coach
PUBLIC_BASE_URL=http://localhost:8000
APP_DEEP_LINK_SCHEME=coach

# Generate both. The Fernet key encrypts stored provider tokens: lose it and
# every connected account has to reconnect.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=
FERNET_KEY=
JWT_ALG=HS256
JWT_EXPIRES_HOURS=720

# ------------------------------------------------------------------- the model
ANTHROPIC_API_KEY=
# Briefs and session adjustments run on the stronger model; chat and headline
# rewrites on the cheaper one.
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001

# Per-user, per-24-hours. Separate allowances: sharing one meant a chatty day
# left someone unable to change their workout.
CHAT_DAILY_MESSAGE_LIMIT=25
CHAT_MAX_OUTPUT_TOKENS=700
ADJUST_DAILY_LIMIT=6

# ------------------------------------------------------------------ sign-in
APPLE_BUNDLE_ID=com.trainwithcoach.app
APPLE_TEAM_ID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=

# ----------------------------------------------------------------- providers
# Which direct connections to OFFER, comma-separated. Empty means Apple Health
# only, which is the launch setting: Strava caps an unreviewed app at 10
# connected athletes and Oura at 10 users, so a public Connect button would 403
# the eleventh person to install.
#
# A provider also needs its credentials before it goes live — the flag alone
# cannot put a broken button in front of anyone. Existing connections keep
# syncing regardless of this list.
DIRECT_PROVIDERS=

OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Deliberately blank: the callback then derives from PUBLIC_BASE_URL, so the two
# cannot drift apart. Set only if a registered URI cannot match our route shape.
OURA_REDIRECT_URI=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

# ------------------------------------------------------------- subscriptions
# Off leaves everything open: trials never expire and nobody is gated.
SUBSCRIPTIONS_ENFORCED=false
TRIAL_DAYS=14
SUBSCRIPTION_PRODUCT_IDS=com.trainwithcoach.app.monthly,com.trainwithcoach.app.yearly
APPLE_IAP_BUNDLE_ID=com.trainwithcoach.app
# Required by Apple's SignedDataVerifier whenever the environment is Production.
# Without it every real purchase raises instead of verifying — and sandbox
# testing never surfaces that.
APPLE_APP_APPLE_ID=6797961960

# ------------------------------------------------------------------- operator
# Who may read aggregate product metrics. Empty closes /v1/admin/metrics
# entirely, which is the right default anywhere nobody configured it.
ADMIN_EMAILS=

# Daily health alerts, sent with a Gmail app password. Unset means the check
# still runs and logs but sends nothing.
ALERT_EMAIL_TO=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=

# ------------------------------------------------------------------- backups
AWS_REGION=us-east-1
BACKUP_BUCKET=
