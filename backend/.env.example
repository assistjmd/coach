# Database
DATABASE_URL=postgresql+psycopg://coach:coach@localhost:5432/coach

# JWT
JWT_SECRET=replace-me-with-openssl-rand-hex-32
JWT_ALG=HS256
JWT_EXPIRES_HOURS=720

# Fernet key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=replace-me

# Apple Sign In
APPLE_BUNDLE_ID=com.coach.app
APPLE_TEAM_ID=

# Google Sign In
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001

# Oura
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Leave blank to derive as {PUBLIC_BASE_URL}/v1/providers/oura/callback.
# Set only if the URI registered with Oura can't match that shape.
OURA_REDIRECT_URI=

# App
APP_ENV=dev
APP_DEEP_LINK_SCHEME=coach
PUBLIC_BASE_URL=http://localhost:8000

# S3 backups (optional in dev)
BACKUP_BUCKET=
AWS_REGION=us-east-2
